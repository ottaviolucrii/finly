<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon of the app on Android 8 and above: the shield of Finly over a white
  background. The phone crops it to a circle, a rounded square and so on. On
  Android 13 a themed (one-colour) version is used when the person asks for it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
